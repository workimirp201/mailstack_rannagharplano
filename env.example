# =============================================================================
#  /opt/mailstack/.env   —   rannagharplano.com mail stack
#  Revision 3 — automated PostgreSQL failover (etcd + Patroni + HAProxy)
#               and webmail (Roundcube) on all three nodes.
# =============================================================================
#  THIS FILE IS IDENTICAL ON ALL THREE NODES EXCEPT FOR NODE_NAME.
#  Fill it in ONCE on mail2, then copy it to the other two and change NODE_NAME.
#
#  chmod 600 /opt/mailstack/.env      <-- MANDATORY, deploy.sh refuses to run
#                                         if this is world-readable.
#
#  Generate every CHANGE_ME at once:
#      /opt/mailstack/deploy.sh gen-secrets      (on mail2 only)
# =============================================================================


# -----------------------------------------------------------------------------
# 1. NODE IDENTITY   ***  THE ONLY LINE THAT DIFFERS PER NODE  ***
# -----------------------------------------------------------------------------
# One of: mail1 | mail2 | mail3
NODE_NAME=mail2


# -----------------------------------------------------------------------------
# 2. TOPOLOGY  (identical on all nodes)
# -----------------------------------------------------------------------------
DOMAIN=rannagharplano.com

# Client-facing endpoints. These now FOLLOW THE PATRONI LEADER automatically:
# the promoted node rewrites these A records via the DNS API (see section 9).
PUBLIC_HOSTNAME=mail.rannagharplano.com
WEBMAIL_HOSTNAME=webmail.rannagharplano.com
DB_HOSTNAME=db.rannagharplano.com

# Multi-A relay name used by nodes that must not send directly (mail3).
# Points at mail1 AND mail2 — MTAs retry other addresses correctly, so
# round-robin is safe HERE even though it is not safe for client access.
SMTP_RELAY_HOSTNAME=smtp-relay.rannagharplano.com

MAIL1_HOST=mail1.rannagharplano.com
MAIL2_HOST=mail2.rannagharplano.com
MAIL3_HOST=mail3.rannagharplano.com

MAIL1_IP=172.104.58.45          # Linode Singapore   (confirmed)
MAIL2_IP=104.237.138.198        # Linode USA
MAIL3_IP=47.190.50.190          # Frontier business, on-prem

# Garage zone per node. One zone per site => one replica per site at RF=3.
MAIL1_ZONE=sg-singapore
MAIL2_ZONE=us-dallas
MAIL3_ZONE=onprem-tx

# --- Is mail3 allowed to send mail directly to the internet? ----------------
# Set to "yes" ONLY when Frontier has set:
#     47.190.50.190  PTR  mail3.rannagharplano.com
# and `dig +short -x 47.190.50.190` confirms it.
# "no" => mail3 relays everything through SMTP_RELAY_HOSTNAME. Safe default.
MAIL3_DIRECT_OUTBOUND=no

# Publish mail3 as MX 30?  Recommended: no. See ARCHITECTURE-REVISION-2 §8.3 —
# mail3 cannot accept mail when the data store is unreachable, which is the
# main scenario a third MX would help with.
MAIL3_PUBLIC_MX=no


# -----------------------------------------------------------------------------
# 3. POSTGRESQL / PATRONI / ETCD   (automated failover)
# -----------------------------------------------------------------------------
PG_VERSION=16
PG_PORT=5432
PG_DATABASE=stalwart
PG_APP_USER=stalwart
PG_APP_PASSWORD=CHANGE_ME
PG_REPL_USER=replicator
PG_REPL_PASSWORD=CHANGE_ME
PG_SUPER_PASSWORD=CHANGE_ME
PG_REWIND_PASSWORD=CHANGE_ME

# Local HAProxy port that ALWAYS points at the current primary.
# Stalwart and Roundcube connect here, never to a node name.
PG_PROXY_PORT=5433

# --- Patroni tuning for a WAN cluster ---------------------------------------
# Constraint enforced by Patroni:  loop_wait + 2*retry_timeout <= ttl
# ttl=120 means a network blip shorter than ~2 minutes will NOT trigger a
# failover. Total automatic failover ≈ 2–3 min, plus 60 s DNS TTL.
# Lower ttl = faster failover but more spurious failovers over a 200 ms WAN.
PATRONI_TTL=120
PATRONI_LOOP_WAIT=20
PATRONI_RETRY_TIMEOUT=40
# A standby lagging more than this many bytes may not be promoted (1 MiB).
PATRONI_MAX_LAG=1048576
PATRONI_SCOPE=rannagharplano
PATRONI_REST_PORT=8008
PATRONI_REST_USER=patroni
PATRONI_REST_PASSWORD=CHANGE_ME

# --- Synchronous replication -------------------------------------------------
# off = asynchronous. An automatic failover may lose the last fraction of a
#       second of WAL. Safe default; works regardless of latency.
# on  = zero-data-loss failover between the two LOW-LATENCY nodes. Turn this
#       on ONLY if `ping mail3` from mail2 is under ~40 ms. mail1 is tagged
#       nosync automatically so Singapore is never the synchronous standby.
PG_SYNCHRONOUS_MODE=off

ETCD_VERSION=v3.6.12
ETCD_CLIENT_PORT=2379
ETCD_PEER_PORT=2380
ETCD_INITIAL_TOKEN=CHANGE_ME
# etcd RBAC. Patroni authenticates with this user in addition to its client cert.
ETCD_ROOT_PASSWORD=CHANGE_ME
ETCD_PATRONI_PASSWORD=CHANGE_ME
# Cross-continent tuning. etcd docs: heartbeat ≈ 0.5–1.5x max RTT,
# election >= 10x RTT. SG<->US is ~200 ms, so 250 / 5000 is conservative.
ETCD_HEARTBEAT_MS=250
ETCD_ELECTION_MS=5000


# -----------------------------------------------------------------------------
# 4. GARAGE S3
# -----------------------------------------------------------------------------
GARAGE_VERSION=v2.4.0

# MUST be byte-identical on all three nodes.  openssl rand -hex 32
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME
GARAGE_METRICS_TOKEN=CHANGE_ME

# Per-node capacity announced to the layout. With replication_factor=3 and one
# zone per node, USABLE CLUSTER CAPACITY == THIS NUMBER (not 3x it).
# 18G sits inside a 20 GB on-disk reservation. See ARCHITECTURE-REVISION-3 §6.
GARAGE_CAPACITY=18G

GARAGE_REPLICATION_FACTOR=3
GARAGE_CONSISTENCY_MODE=consistent
GARAGE_DB_ENGINE=lmdb
GARAGE_S3_REGION=garage

GARAGE_RPC_PORT=3901
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
GARAGE_ADMIN_PORT=3903

GARAGE_BUCKET=stalwart-blobs
GARAGE_KEY_NAME=stalwart-app-key
# Hard ceiling so a mail flood cannot fill every node's disk.
GARAGE_BUCKET_MAX_SIZE=15GiB


# -----------------------------------------------------------------------------
# 5. S3 CREDENTIALS FOR STALWART
# -----------------------------------------------------------------------------
# Leave as CHANGE_ME on the first run. `deploy.sh garage-cluster` (mail2 only)
# creates the key and prints both values; paste them here on ALL THREE nodes.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME


# -----------------------------------------------------------------------------
# 6. STALWART
# -----------------------------------------------------------------------------
STALWART_VERSION=v0.16.19

STALWART_BOOTSTRAP_ADMIN_USER=setupadmin
STALWART_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=CHANGE_ME

STALWART_CLUSTER_SECRET=CHANGE_ME
STALWART_ZENOH_PORT=7447

# Stalwart's HTTPS listener moves behind nginx SNI routing on 443.
STALWART_HTTPS_BACKEND_PORT=10443

# Dedicated account mail3 uses to relay outbound through mail1/mail2.
STALWART_RELAY_USER=relay-mail3@rannagharplano.com
STALWART_RELAY_PASSWORD=CHANGE_ME


# -----------------------------------------------------------------------------
# 7. WEBMAIL  (Roundcube — installed on ALL THREE nodes so the client endpoint
#              can follow the Patroni leader without manual work)
# -----------------------------------------------------------------------------
ROUNDCUBE_VERSION=1.7.4
ROUNDCUBE_DB=roundcube
ROUNDCUBE_DB_USER=roundcube
ROUNDCUBE_DB_PASSWORD=CHANGE_ME
# Roundcube requires EXACTLY 24 characters here.
ROUNDCUBE_DES_KEY=CHANGE_ME
ROUNDCUBE_PRODUCT_NAME="Rannaghar Plano Mail"
# Internal port the webmail vhost listens on; nginx SNI-routes 443 to it.
WEBMAIL_BACKEND_PORT=10444
PHP_VERSION=8.3


# -----------------------------------------------------------------------------
# 8. TLS / ACME
# -----------------------------------------------------------------------------
ACME_CONTACT=postmaster@rannagharplano.com

# Stalwart's own certificate: DNS-01 is REQUIRED in a cluster (the validating
# node is not the node each name resolves to).
ACME_CHALLENGE=dns01

# Provider used BOTH for Stalwart's ACME and for the webmail certbot cert and
# the failover DNS updates. Supported here: cloudflare | route53 | manual
ACME_DNS_PROVIDER=cloudflare
ACME_DNS_API_TOKEN=CHANGE_ME

# Cloudflare only: the Zone ID for rannagharplano.com (Overview page, right rail).
# Required for automatic endpoint failover.
CF_ZONE_ID=CHANGE_ME


# -----------------------------------------------------------------------------
# 9. AUTOMATIC ENDPOINT FAILOVER
# -----------------------------------------------------------------------------
# When Patroni promotes a node, that node runs bin/patroni-callback.sh, which
# repoints these A records at itself. TTL 60 => clients follow in about a minute.
# Set to "no" to disable and handle DNS yourself.
DNS_FAILOVER_ENABLED=yes
DNS_FAILOVER_RECORDS="mail webmail db"
DNS_FAILOVER_TTL=60


# -----------------------------------------------------------------------------
# 10. BACKUPS
# -----------------------------------------------------------------------------
BACKUP_DIR=/var/backups/mailstack
BACKUP_RETENTION_DAYS=14
BACKUP_PASSPHRASE=CHANGE_ME
